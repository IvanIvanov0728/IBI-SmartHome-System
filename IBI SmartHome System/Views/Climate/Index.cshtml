@{
    ViewData["Title"] = "Climate Control";
}

<header class="mb-5">
    <h1 class="h3 fw-bold text-dark">Climate Control</h1>
    <p class="text-muted">Perfect temperature, everywhere.</p>
</header>

<div class="row g-4">
    <div class="col-lg-5">
        <partial name="_Thermostat" />
    </div>
    <div class="col-lg-7">
        <div class="d-flex flex-column gap-4">
            <div class="card rounded-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="card-title fs-5 fw-semibold mb-0">Weekly Schedule</h3>
                        <button class="btn btn-sm btn-outline-primary">Edit</button>
                    </div>
                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-2 bg-light-subtle rounded-2">
                                    <i data-lucide="clock"></i>
                                </div>
                                <div>
                                    <div class="fw-medium small">Mon-Fri</div>
                                    <div class="text-muted small">07:00 AM</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <span class="fw-bold fs-5">72°</span>
                                <span class="badge bg-light text-dark">Heat</span>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-2 bg-light-subtle rounded-2">
                                    <i data-lucide="clock"></i>
                                </div>
                                <div>
                                    <div class="fw-medium small">Mon-Fri</div>
                                    <div class="text-muted small">09:00 AM</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <span class="fw-bold fs-5">68°</span>
                                <span class="badge bg-success-subtle text-success">Eco</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card rounded-4">
                <div class="card-body">
                    <h3 class="card-title fs-5 fw-semibold mb-4">Smart Features</h3>
                    <div class="d-flex flex-column gap-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <i data-lucide="zap" class="text-warning"></i>
                                <div>
                                    <div class="fw-medium">Energy Saver</div>
                                    <div class="text-muted small">Adjust temp when away</div>
                                </div>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" checked>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <i data-lucide="wind" class="text-info"></i>
                                <div>
                                    <div class="fw-medium">Fan Cycle</div>
                                    <div class="text-muted small">Circulate air periodically</div>
                                </div>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>