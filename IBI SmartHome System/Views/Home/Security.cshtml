@{
    ViewData["Title"] = "Security";
}

<header class="mb-5 d-flex align-items-center justify-content-between">
    <div>
        <h1 class="h3 fw-bold text-dark">Security</h1>
        <p class="text-muted">System Status: Armed (Home)</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-danger d-flex align-items-center gap-2">
            <i data-lucide="alert-triangle" class="wh-16"></i> Panic
        </button>
        <button class="btn btn-success d-flex align-items-center gap-2">
            <i data-lucide="shield" class="wh-16"></i> Armed
        </button>
    </div>
</header>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card rounded-4">
            <div class="card-body">
                <div class="aspect-ratio ratio-16x9 bg-dark rounded-3 d-flex align-items-center justify-content-center text-white-50">
                    Camera Feed
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card rounded-4">
            <div class="card-body">
                <h3 class="card-title fs-5 fw-semibold mb-4">Entry Points</h3>
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3">
                        <div class="d-flex align-items-center gap-3">
                            <i data-lucide="lock" class="text-success"></i>
                            <span class="fw-medium small">Front Door</span>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" checked>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3">
                        <div class="d-flex align-items-center gap-3">
                            <i data-lucide="unlock" class="text-warning"></i>
                            <span class="fw-medium small">Back Door</span>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card rounded-4">
    <div class="card-body">
        <h3 class="card-title fs-5 fw-semibold mb-4">Recent Activity</h3>
        <div class="d-flex flex-column gap-3">
            <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3">
                <span class="small text-muted">10:42 AM</span>
                <span class="small">Front Door Locked</span>
            </div>
            <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3">
                <span class="small text-muted">10:30 AM</span>
                <span class="small">Motion Detected at Front Porch</span>
            </div>
        </div>
    </div>
</div>