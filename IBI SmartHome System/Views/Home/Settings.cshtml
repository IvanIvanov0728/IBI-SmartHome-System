@{
    ViewData["Title"] = "Settings";
}

<header class="mb-5">
    <h1 class="h3 fw-bold text-dark">Settings</h1>
    <p class="text-muted">Customize your experience</p>
</header>

<div class="mx-auto" style="max-width: 48rem;">
    <div class="d-flex flex-column gap-4">
        <div class="card rounded-4">
            <div class="card-body p-4 d-flex align-items-center gap-4">
                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <span class="fs-2 fw-bold">A</span>
                </div>
                <div class="flex-grow-1">
                    <h2 class="h5 fw-bold">Ivan Ivanov</h2>
                    <p class="text-muted">Admin • Home Owner</p>
                </div>
                <button class="btn btn-outline-primary">Edit Profile</button>
            </div>
        </div>

        <div class="card rounded-4">
            <div class="card-header bg-transparent py-3">
                <h3 class="h5 fw-semibold mb-0">General</h3>
            </div>
            <div class="list-group list-group-flush">
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <i data-lucide="bell" class="text-primary"></i>
                        <div>
                            <div class="fw-medium">Notifications</div>
                            <div class="small text-muted">Manage alerts & push notifications</div>
                        </div>
                    </div>
                    <i data-lucide="chevron-right" class="text-muted"></i>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <i data-lucide="moon" class="text-primary"></i>
                        <div>
                            <div class="fw-medium">Dark Mode</div>
                            <div class="small text-muted">Adjust system appearance</div>
                        </div>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch">
                    </div>
                </div>
            </div>
        </div>

        <div class="card rounded-4">
            <div class="card-header bg-transparent py-3">
                <h3 class="h5 fw-semibold mb-0">System</h3>
            </div>
            <div class="list-group list-group-flush">
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <i data-lucide="wifi" class="text-success"></i>
                        <div>
                            <div class="fw-medium">Network</div>
                            <div class="small text-muted">Lumina_Home_5G</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-success-subtle text-success">Excellent</span>
                        <i data-lucide="chevron-right" class="text-muted"></i>
                    </div>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <i data-lucide="shield" class="text-warning"></i>
                        <div>
                            <div class="fw-medium">Privacy & Security</div>
                            <div class="small text-muted">2FA Enabled</div>
                        </div>
                    </div>
                    <i data-lucide="chevron-right" class="text-muted"></i>
                </div>
            </div>
        </div>

        <div class="d-grid gap-2">
            <button class="btn btn-light text-start"><i data-lucide="help-circle" class="me-2"></i> Help & Support</button>
            <button class="btn btn-light text-danger text-start"><i data-lucide="log-out" class="me-2"></i> Log Out</button>
        </div>
    </div>
</div>