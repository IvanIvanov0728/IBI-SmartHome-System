@{
    ViewData["Title"] = "Scenes";
}

<header class="mb-5 d-flex align-items-center justify-content-between">
    <div>
        <h1 class="h3 fw-bold text-dark">Scenes</h1>
        <p class="text-muted">Automate your environment</p>
    </div>
    <button class="btn btn-primary rounded-pill d-flex align-items-center gap-2">
        <i data-lucide="plus" class="wh-16"></i> Create Scene
    </button>
</header>

<div class="row g-4">
    <div class="col-sm-6 col-md-4 col-lg-3">
        <div class="card rounded-4 h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; background-color: #ffe8cc; color: #ff8c00;">
                        <i data-lucide="sun" class="wh-28"></i>
                    </div>
                </div>
                <h3 class="h5 fw-bold mb-1">Good Morning</h3>
                <p class="small text-muted mb-3">Blinds up, lights 50%, coffee on</p>
                <div class="mt-auto">
                    <button class="btn btn-sm btn-outline-primary w-100">Activate</button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4 col-lg-3">
        <div class="card rounded-4 h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; background-color: #e6e6fa; color: #483d8b;">
                        <i data-lucide="moon" class="wh-28"></i>
                    </div>
                </div>
                <h3 class="h5 fw-bold mb-1">Good Night</h3>
                <p class="small text-muted mb-3">All off, doors locked, temp 68°</p>
                <div class="mt-auto">
                    <button class="btn btn-sm btn-outline-primary w-100">Activate</button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4 col-lg-3">
        <div class="card rounded-4 h-100 border-primary">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; background-color: #f3e5f5; color: #8e24aa;">
                        <i data-lucide="film" class="wh-28"></i>
                    </div>
                    <span class="badge bg-primary">Active</span>
                </div>
                <h3 class="h5 fw-bold mb-1">Movie Time</h3>
                <p class="small text-muted mb-3">Lights dimmed, TV backlight on</p>
                <div class="mt-auto">
                    <button class="btn btn-sm btn-primary w-100">Stop</button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4 col-lg-3">
        <div class="card rounded-4 h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; background-color: #e0f2f1; color: #00897b;">
                        <i data-lucide="log-out" class="wh-28"></i>
                    </div>
                </div>
                <h3 class="h5 fw-bold mb-1">Leaving Home</h3>
                <p class="small text-muted mb-3">Security armed, eco mode on</p>
                <div class="mt-auto">
                    <button class="btn btn-sm btn-outline-primary w-100">Activate</button>
                </div>
            </div>
        </div>
    </div>
</div>