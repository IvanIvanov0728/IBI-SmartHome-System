<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IBI SmartHome System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IBI_SmartHome_System.styles.css" asp-append-version="true" />
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
</head>
<body>
    <aside class="sidebar d-none d-lg-block">
        <div class="d-flex flex-column h-100 p-3">
            <div class="px-3 mb-4 d-flex align-items-center gap-2">

                @* tova trqbva da se napravi dinamichno *@ 
                <div class="d-flex align-items-center justify-content-center fw-bold" style="width: 2rem; height: 2rem; background-color: #0d6efd; color: white; border-radius: 50%;">
                    II
                </div>
                <span class="fs-5 fw-bold">Ivan Ivanov</span>
            </div>

            <nav class="nav flex-column flex-grow-1">
                <a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i data-lucide="layout-dashboard"></i><span>Dashboard</span></a>
                <a class="nav-link" asp-controller="Lighting" asp-action="Index"><i data-lucide="lightbulb"></i><span>Lighting</span></a>
                <a class="nav-link" asp-controller="Climate" asp-action="Index"><i data-lucide="thermometer"></i><span>Climate</span></a>
                <a class="nav-link" asp-controller="Home" asp-action="Security"><i data-lucide="shield"></i><span>Security</span></a>
                <a class="nav-link" asp-controller="Home" asp-action="Settings"><i data-lucide="settings"></i><span>Settings</span></a>
            </nav>
        </div>
    </aside>

    <div class="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        lucide.createIcons();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
