@model IBI_SmartHome_System.Service.Models.LightControlViewModel

<div class="card rounded-4 @(Model.IsOn ? "shadow-sm" : "opacity-75")">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center justify-content-center rounded-circle @(Model.IsOn ? "bg-warning-subtle text-warning" : "bg-light text-muted")" style="width: 40px; height: 40px;">
                    <i data-lucide="lamp"></i>
                </div>
                <div>
                    <h4 class="card-title fs-6 fw-medium mb-0">@Model.Name</h4>
                    <span class="text-muted small">@(Model.IsOn ? $"{Model.Brightness}% Brightness" : "Off")</span>
                </div>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="light-switch-@Model.Id" checked="@Model.IsOn">
            </div>
        </div>

        <div class="d-flex flex-column gap-2">
            <div class="d-flex justify-content-between text-muted px-1">
                <i data-lucide="moon" class="w-25"></i>
                <i data-lucide="sun" class="w-25"></i>
            </div>
            <input type="range" class="form-range" min="0" max="100" step="1" value="@Model.Brightness" id="light-slider-@Model.Id" disabled="@(!Model.IsOn)">
        </div>
    </div>
</div>

