@model IBI_SmartHome_System.Service.Models.DashboardViewModel
@*
    This partial view is a translation of the Thermostat.tsx component from the React application.
*@
<div class="card rounded-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="card-title fs-5 fw-semibold mb-0">Climate</h3>
            <div class="btn-group bg-light rounded-pill p-1" role="group" aria-label="Climate modes">
                <button type="button" class="btn btn-sm btn-light rounded-pill active" data-bs-toggle="tooltip" data-bs-placement="top" title="Cool">
                    <i data-lucide="snowflake"></i>
                </button>
                <button type="button" class="btn btn-sm btn-light rounded-pill" data-bs-toggle="tooltip" data-bs-placement="top" title="Heat">
                    <i data-lucide="flame"></i>
                </button>
                <button type="button" class="btn btn-sm btn-light rounded-pill" data-bs-toggle="tooltip" data-bs-placement="top" title="Fan">
                    <i data-lucide="fan"></i>
                </button>
            </div>
        </div>

        <div class="text-center my-5">
            <div class="display-3 fw-bold">@Model.TargetTemperature.ToString()</div>
            <div class="text-muted">Target</div>
        </div>

        <div class="d-flex justify-content-center align-items-center gap-4">
            <button class="btn btn-outline-secondary rounded-circle" style="width: 50px; height: 50px;">
                <i data-lucide="minus"></i>
            </button>
            <button class="btn btn-outline-secondary rounded-circle" style="width: 50px; height: 50px;">
                <i data-lucide="plus"></i>
            </button>
        </div>
    </div>
</div>
